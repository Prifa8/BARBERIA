rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Hardcoded admin email for initial setup as per user request/metadata context
      return isSignedIn() && (
        request.auth.token.email == 'prilautarofabri@gmail.com' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && 
                      request.resource.data.keys().hasAll(['uid', 'email', 'role']) &&
                      request.resource.data.role == 'customer'; // Self-register only as customer
      allow update: if isOwner(userId) && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'bio']);
      allow write: if isAdmin();
    }

    // --- BOOKINGS COLLECTION ---
    match /bookings/{bookingId} {
      // Users can see their own bookings
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      
      // Creation
      allow create: if isSignedIn() && 
                      request.resource.data.customerId == request.auth.uid &&
                      request.resource.data.status == 'confirmed';
      
      // Updates (Cancellation by user or status update by admin)
      allow update: if isSignedIn() && (
        (isOwner(resource.data.customerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'cancelled') ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // --- LOCATIONS COLLECTION ---
    match /locations/{locationId} {
      allow read: if true; // Publicly viewable
      allow write: if isAdmin();
    }

    // --- ADMINS COLLECTION ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or very restricted admin logic
    }
  }
}
